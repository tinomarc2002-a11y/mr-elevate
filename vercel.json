{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/leitfaden",
      "destination": "https://www.marketingmitmarc.de/guide",
      "permanent": true
    },
    {
      "source": "/neukundengewinnung-solarbetriebe",
      "destination": "https://www.marketingmitmarc.de/solar-leads",
      "permanent": true
    },
    {
      "source": "/ratgeber/e-rechnungspflicht",
      "destination": "https://www.marketingmitmarc.de/ratgeber/registrierkassenpflicht",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.marketingmitmarc.de/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/solar-leads/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/solar-leads/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/seo-check",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/seo-check.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
